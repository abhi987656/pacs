{
  "name": "personal-pacs",
  "productName": "Personal PACS",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user DICOM viewer and radiology reporting workstation for Windows",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "node scripts/copy-wasm.mjs && electron-vite dev",
    "build": "node scripts/copy-wasm.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "@cornerstonejs/core": "^5.15.2",
    "@cornerstonejs/dicom-image-loader": "^5.15.2",
    "@cornerstonejs/tools": "^5.15.2",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "events": "^3.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar-stream": "^2.2.0",
    "typescript": "^5.9.3",
    "unbzip2-stream": "^1.4.3",
    "vite": "^8.3.6"
  },
  "author": "Personal PACS",
  "homepage": "https://github.com/abhi987656/pacs"
}
